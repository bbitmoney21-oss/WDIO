PORT=3000
CORS_ORIGIN=*
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CLINIC_ADMIN_EMAIL=clinic-admin@example.com
BOOKING_AGENT_API_URL=https://api.canadataxpro.me
PRICING_ADMIN_TOKEN=replace-with-strong-admin-token
CALENDLY_LINK=https://calendly.com/YOUR_USERNAME/demo
FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID

# Twilio SMS (kept for inbound SMS — voice layer replaced by Retell)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public URL — used for webhook base URLs
PUBLIC_URL=https://api.canadataxpro.me

# ─── Retell AI Voice ───────────────────────────────────────────────────────────
RETELL_API_KEY=your_retell_api_key
# Phone number registered in Retell for outbound calls
RETELL_PHONE_NUMBER=+1xxxxxxxxxx
# Default agent ID (set after creating agent via /api/admin/retell/setup)
RETELL_AGENT_ID=
# Voice ID to use for the Retell agent (see Retell dashboard for options)
RETELL_VOICE_ID=openai-Shimmer
# LLM model used by the Retell agent
RETELL_LLM_MODEL=gpt-4o
