PORT=3000
CORS_ORIGIN=*
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CLINIC_ADMIN_EMAIL=clinic-admin@example.com
BOOKING_AGENT_API_URL=https://api.canadataxpro.me
PRICING_ADMIN_TOKEN=replace-with-strong-admin-token
CALENDLY_LINK=https://calendly.com/YOUR_USERNAME/demo
FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID

# Twilio Voice
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Public URL used for Twilio webhook signature validation
PUBLIC_URL=https://api.canadataxpro.me
# Voice tenant resolution (overrides demo fallback)
VOICE_API_KEY=
VOICE_TENANT_ID=
# Demo fallback type: restaurant | clinic
VOICE_DEMO_TYPE=restaurant
